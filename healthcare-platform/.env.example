# ==============================================================================
# AI-Powered Healthcare Service Management Platform - Environment Variables
# Copy this file to .env and fill in secure values before running locally.
# NEVER commit your real .env file to version control.
# ==============================================================================

# Active Spring Profile: use "mysql" for local MySQL Workbench (MySQL 8/9), or leave empty/default for PostgreSQL
SPRING_PROFILES_ACTIVE=mysql

# Local MySQL 9.0 Database Configuration (used when SPRING_PROFILES_ACTIVE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_root_password

# PostgreSQL Database Configuration (used when running default profile or Docker Compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=healthcare_platform
POSTGRES_USER=healthcare_admin
POSTGRES_PASSWORD=change_me_secure_pg_password

# JWT Security Configuration (minimum 256-bit Base64 secret recommended)
# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_a_long_random_base64_encoded_256bit_secret_key
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Microservice Internal URLs (local dev defaults; overridden in Docker Compose)
API_GATEWAY_PORT=8080
AUTH_SERVICE_URL=http://localhost:8081
PATIENT_SERVICE_URL=http://localhost:8082
DOCTOR_SERVICE_URL=http://localhost:8083
APPOINTMENT_SERVICE_URL=http://localhost:8084
NOTIFICATION_SERVICE_URL=http://localhost:8085
AI_ASSISTANT_SERVICE_URL=http://localhost:8086

# OpenAI / Spring AI Configuration (used ONLY by ai-assistant-service on backend)
OPENAI_API_KEY=sk-replace-with-your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4o-mini

# Frontend (Vite) Public Gateway URL
VITE_API_BASE_URL=http://localhost:8080/api/v1
