{
  "info": {
    "name": "CareFlow AI Healthcare Platform API",
    "description": "Complete Postman collection for API Gateway (:8080) and all 6 backend microservices.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "accessToken", "value": "" }
  ],
  "item": [
    {
      "name": "1. Auth - Register Patient",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Liam Miller\",\n  \"email\": \"liam.new@careflow.local\",\n  \"password\": \"StrongPass123!\",\n  \"role\": \"PATIENT\"\n}"
        }
      }
    },
    {
      "name": "2. Auth - Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"patient.miller@careflow.local\",\n  \"password\": \"Patient@123\"\n}"
        }
      }
    },
    {
      "name": "3. Doctors - Search by Specialization",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/doctors?specialization=Cardiology"
      }
    },
    {
      "name": "4. Patients - List Paginated",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/patients?page=0&size=10&sortBy=lastName&sortDir=asc"
      }
    },
    {
      "name": "5. Appointments - Book Appointment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/appointments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"patientId\": 1,\n  \"doctorId\": 1,\n  \"appointmentDate\": \"2026-12-07\",\n  \"startTime\": \"10:00:00\",\n  \"endTime\": \"10:30:00\",\n  \"visitType\": \"IN_PERSON\",\n  \"reason\": \"Routine cardiology follow-up\"\n}"
        }
      }
    },
    {
      "name": "6. Notifications - My Inbox",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/notifications/my"
      }
    },
    {
      "name": "7. AI Assistant - Safe Chat",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/ai/chat",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"What documents should I bring for my first visit?\",\n  \"consentToProcess\": true\n}"
        }
      }
    },
    {
      "name": "8. AI Assistant - Summarize Service Request",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "url": "{{baseUrl}}/ai/summarize-request",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": \"MEDICAL_RECORDS\",\n  \"subject\": \"ECG report copy\",\n  \"description\": \"Need a PDF copy of last month's screening for my new insurer.\",\n  \"consentToProcess\": true\n}"
        }
      }
    }
  ]
}
